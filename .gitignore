# Runtime artefacts — never committed to the code repo (nightly data goes to the data repo)
work/
build/
data/*.sqlite
data/*.sqlite-*
data/nightly/
gate/rejected/
logs/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Secrets and local env
.env
*.env

# Build environment
logs/*
!logs/.gitkeep
data/dryrun*
data/transcripts/
data/posts/
gate/candidates/

# Task fixtures may legitimately contain env files and logs
!tasks/**/*.env
!tasks/**/.env
!tasks/**/logs/
