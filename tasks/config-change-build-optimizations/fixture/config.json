{
    "backend": "c",
    "output-dir": "build",
    "optimizations": {
        "static-type-inference": true,
        "constant-folding": true,
        "dead-code-elimination": false,
        "call-gatherer-pass": false,
        "inline-cache": true
    },
    "warnings": {
        "unused-variable": true,
        "possible-wrong-parameter": true
    }
}
